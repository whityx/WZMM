{
  "name": "why-zenless-mod-manager",
  "version": "2.0.0",
  "description": "ZZZ Mod Manager for Linux",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.6.0",
    "node-unrar-js": "^2.0.2"
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "build": {
    "appId": "com.whityx.wzmm",
    "productName": "WZMM",
    "artifactName": "WZMM-2.0.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "executableName": "WZMM-2.0",
      "artifactName": "WZMM-2.0.${ext}"
    },
    "files": [
      "**/*",
      "!settings.json",
      "!dowlinks.json",
      "!.git/**/*",
      "!dist/**/*"
    ]
  }
}