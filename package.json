{
  "name": "why-zenless-mod-manager",
  "version": "0.2.2",
  "description": "ZZZ Mod Manager for windows & linux",
  "main": "main.js",
  "author": "whityx",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -wl",
    "build": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -wl"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.6.0",
    "node-unrar-js": "^2.0.2"
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "build": {
    "appId": "com.whityx.wzmm",
    "productName": "WZMM",
    "artifactName": "WZMM-0.2.2.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "executableName": "WZMM-0.2.2",
      "artifactName": "WZMM-0.2.2.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "WZMM-0.2.2-Setup.${ext}"
    },
    "portable": {
      "artifactName": "WZMM-0.2.2-Portable.${ext}"
    },
    "files": [
      "**/*",
      "!settings.json",
      "!dowlinks.json",
      "!.git/**/*",
      "!dist/**/*"
    ]
  }
}