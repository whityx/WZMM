{
  "name": "why-zenless-mod-manager",
  "version": "0.3.0",
  "description": "ZZZ Mod Manager for windows & linux",
  "main": "main.js",
  "author": "whityx",
  "scripts": {
    "start": "electron .",
    "prebuild": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\"",
    "predist": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\"",
    "dist": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -wl",
    "build": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -wl"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.6.0",
    "node-unrar-js": "^2.0.2"
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "build": {
    "appId": "com.whityx.wzmm",
    "productName": "WZMM",
    "artifactName": "WZMM-${version}.${ext}",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/7zip-bin/**/*",
      "modelviewer/**/*",
      "themes/**/*",
      "locales/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "executableName": "WZMM-${version}",
      "artifactName": "WZMM-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "WZMM-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "WZMM-${version}-Portable.${ext}"
    },
    "files": [
      "**/*",
      "!settings.json",
      "!dowlinks.json",
      "!.git/**/*",
      "!dist/**/*",
      "!modelviewer/.venv/**/*",
      "!.agents/**/*",
      "!.tests/**/*"
    ]
  }
}